  "inventory_schema": {
    "document": [
      "schema=2",
      "complete",
      "reasons",
      "incomplete_reasons",
      "matrix_sha256",
      "boot_id",
      "collected_start_ns",
      "collected_end_ns",
      "scans>=2",
      "processes",
      "units",
      "production_surface"
    ],
    "label_rule": "label == '<apparmor_profile> (enforce)' and unit == services[role].unit; anything else blocks",
    "membership": "every process with ANY uid/gid/supplementary group == 33, plus every member of every service cgroup (root masters included)",
    "process": [
      "pid",
      "ppid",
      "state",
      "uids[4]",
      "gids[4]",
      "groups",
      "comm",
      "argv0",
      "cmdline_sha256",
      "starttime",
      "label",
      "unit",
      "cgroup",
      "exe",
      "fds"
    ],
    "stability": "two consecutive scans identical on (pid,starttime,label,unit,uids,gids,groups); churn/unreadable/cgroup disagreement => complete=false",
    "units": [
      "nginx.service",
      "php8.4-fpm.service",
      "php8.5-fpm.service",
      "supervisor.service",
      "wpcaregrid-production-php8.5-fpm.service",
      "wpcaregrid-staging-legacy-scheduler.service",
      "wpcaregrid-staging-next-scheduler.service"
    ]
  },
  "package_version": "1.0.6",
  "phases": {
    "post": "all roles",
    "pre": "production role excluded; production unit has no process; no non-fixture production file"
  },
  "rules": {
    "class_identity": "a process class is the pair (AppArmor label, systemd unit/cgroup); production and staging-next both run /usr/sbin/php-fpm8.5, so the executable, argv0 and PHP version never identify an environment",
    "deploy_cli_network": "unix-stream connect to the exact MySQL socket only; no TCP",
    "exec_path_attachments": [],
    "package_owner_mode": {
      "gid": 0,
      "mode": "0644",
      "nlink": 1,
      "type": "regular",
      "uid": 0
    },
    "permitted_group33_holders": [],
    "php_runtime": {
      "production": "8.5",
      "staging-legacy": "8.4",
      "staging-next": "8.5"
    },
    "production_jobs": "fenced: scheduler units masked+inactive, no active/autostart wpcaregrid-production-* supervisor program, both fence markers",
    "role_runtime": {
      "production": {
        "fpm_binary": "/usr/sbin/php-fpm8.5",
        "pool_dir": "/etc/php/8.5/fpm-wpcaregrid-production",
        "socket": "/run/php/wpcaregrid-production-php8.5-fpm.sock"
      },
      "staging-legacy": {
        "fpm_binary": "/usr/sbin/php-fpm8.4",
        "pool_dir": "/etc/php/8.4/fpm",
        "socket": "/run/php/php8.4-fpm.sock"
      },
      "staging-next": {
        "fpm_binary": "/usr/sbin/php-fpm8.5",
        "pool_dir": "/etc/php/8.5/fpm",
        "socket": "/run/php/php8.5-fpm.sock"
      }
    },
    "transient_classes": [
      "production-deploy-cli",
      "production-build-cli"
    ],
    "unconfined_same_uid_classes": [],
    "www_data_cron_permitted": false
  },
