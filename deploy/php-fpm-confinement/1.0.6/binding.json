{
  "aa_exec_profiles": {
    "wpcaregrid-php-cli-production-build": {
      "argv0": "/usr/bin/php8.5",
      "cgroup": "the root-console helper's session or transient scope; never a *.service unit",
      "cgroup_regex": "^0::/user\\.slice/user-0\\.slice/session-[0-9]+\\.scope$",
      "commands_disabled": [
        {
          "id": "phase-b-migration-runner",
          "reason": "Phase B stays disabled and is not authorized: it needs database DDL, AppArmor cannot tell DDL from a query on the allowed unix socket, and its current runner uses TCP host/port, which this profile never allows. It needs its own conversion and review before it could ever be enabled."
        }
      ],
      "commands_supported": [
        {
          "argv": [
            "/usr/bin/php8.5",
            "artisan",
            "package:discover",
            "--ansi",
            "--no-interaction"
          ],
          "id": "package-discover",
          "network": "none"
        },
        {
          "argv": [
            "/usr/bin/php8.5",
            "artisan",
            "config:cache",
            "--no-interaction"
          ],
          "id": "config-cache",
          "network": "none"
        }
      ],
      "exe": "/usr/bin/php8.5",
      "exec_path_attachment": null,
      "files": [
        "/etc/apparmor.d/abstractions/wpcaregrid-php-fpm-common",
        "/etc/apparmor.d/wpcaregrid-php-cli-production-build"
      ],
      "gids": [
        33,
        33,
        33,
        33
      ],
      "lifetime": "short-lived child of the root-console helper; never a service; none may exist in the pre-production phase or during rollback",
      "max_age_seconds": 960,
      "network": "none; all socket and network access denied",
      "peer_label": "wpcaregrid-php-cli-production-build (enforce)",
      "phase_b_interpreter": "Phase B stays disabled and is not authorized: the profile cannot distinguish DDL from a query on the allowed socket, so keeping Phase B off is helper policy",
      "profile_path": "/etc/apparmor.d/wpcaregrid-php-cli-production-build",
      "reads": [
        "production releases tree",
        "production shared .env",
        "production shared vendor"
      ],
      "residuals": [
        "the write grants cover every release's bootstrap/cache, including the live release that FPM includes; helper seals generated cache before activation",
        "child stdout/stderr go to the helper and are not confinable: the helper must not store them where staging can read them"
      ],
      "selected_by": "production root-console helper only for offline package:discover/config:cache commands; no DB or network",
      "uids": [
        33,
        33,
        33,
        33
      ],
      "unit": null,
      "unit_attachment": null,
      "writes": [
        "production releases/*/bootstrap/cache",
        "production shared storage/logs",
        "production shared storage/framework/cache and views"
      ]
    },
    "wpcaregrid-php-cli-production-deploy": {
      "argv0": "/usr/bin/php8.5",
      "cgroup": "the root-console helper's session or transient scope; never a *.service unit",
      "cgroup_regex": "^0::/user\\.slice/user-0\\.slice/session-[0-9]+\\.scope$",
      "commands_disabled": [
        {
          "id": "phase-b-migration-runner",
          "reason": "Phase B stays disabled and is not authorized: it needs database DDL, AppArmor cannot tell DDL from a query on the allowed unix socket, and its current runner uses TCP host/port, which this profile never allows. It needs its own conversion and review before it could ever be enabled."
        }
      ],
      "commands_supported": [
        {
          "argv": [
            "/usr/bin/php8.5",
            "-r",
            "<fixed config-only probe>"
          ],
          "id": "runtime-identity-probe",
          "network": "unix stream connect to /run/mysqld/wpcaregrid-production.sock only",
          "note": "connects with unix_socket set to exactly that path; no host/port, no TCP fallback; the helper must verify the observed mysqld socket and keep the exact server-UUID check"
        }
      ],
      "exe": "/usr/bin/php8.5",
      "exec_path_attachment": null,
      "files": [
        "/etc/apparmor.d/abstractions/wpcaregrid-php-fpm-common",
        "/etc/apparmor.d/wpcaregrid-php-cli-production-deploy"
      ],
      "gids": [
        33,
        33,
        33,
        33
      ],
      "lifetime": "short-lived child of the root-console helper; never a service; none may exist in the pre-production phase or during rollback",
      "max_age_seconds": 960,
      "mysql_unix_socket": {
        "alternates_denied": [
          "/run/mysqld/wpcaregrid-production-restore.sock",
          "/run/mysqld/mysqld.sock",
          "/run/mysqld/wpcaregrid-production.sock.lock",
          "/run/mysqld/*.pid"
        ],
        "path": "/run/mysqld/wpcaregrid-production.sock",
        "policy": "root-controlled: a fixed path in the profile and in this binding, never from the environment; the helper must verify the observed mysqld socket (path, socket type, owned by the mysql instance) equals it and keep the exact server-UUID check; any other path fails closed; the live host path has NOT been checked by B",
        "source": "scripts/production_g1_mysql_contract.py production instance socket",
        "type": "socket"
      },
      "network": "unix-stream connect to the exact MySQL socket only; no TCP; read-only application tree",
      "peer_label": "wpcaregrid-php-cli-production-deploy (enforce)",
      "phase_b_interpreter": "Phase B stays disabled and is not authorized: the profile cannot distinguish DDL from a query on the allowed socket, so keeping Phase B off is helper policy",
      "profile_path": "/etc/apparmor.d/wpcaregrid-php-cli-production-deploy",
      "reads": [
        "production releases tree",
        "production shared .env",
        "production shared vendor"
      ],
      "residuals": [
        "inherited stream descriptors are not tied to the MySQL peer (the parser rejects a pathname peer address): the helper must start the CLI with no inherited sockets and close_fds",
        "the allowed socket is a data channel: the DB grant must have no FILE, REPLICATION or SUPER privilege, secure_file_priv set and local_infile off",
        "child stdout/stderr go to the helper and are not confinable: the helper must not store them where staging can read them"
      ],
      "runtime_probe_constraint": "uses unix socket only at the fixed production MySQL path; no host/port and no TCP fallback; helper verifies observed mysqld socket and exact server UUID",
      "selected_by": "production root-console helper only for the read-only runtime identity probe",
      "uids": [
        33,
        33,
        33,
        33
      ],
      "unit": null,
      "unit_attachment": null,
      "writes": []
    }
  },
