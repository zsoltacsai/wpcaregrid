# =============================================================================
# WP CareGrid environment. Values here are development defaults and contain
# no secrets. Production values: docs/DEPLOYMENT.md (and RELEASE_CHECKLIST.md).
# Check a configured server with: php artisan system:check
# =============================================================================

# ----- Application ------------------------------------------------------------
APP_NAME="WP CareGrid"
# production on the live server (debug must be false there).
APP_ENV=local
# php artisan key:generate (never reuse a key between environments).
APP_KEY=
APP_DEBUG=true
# The public https:// address in production. Links in emails, redirects and signed URLs use it.
APP_URL=http://localhost:8000
# Explicit deployment identity; staging deployments set this to staging.
CAREGRID_DEPLOYMENT_ENV=local
# Required with CAREGRID_DEPLOYMENT_ENV=staging; must be the staging app host identity.
CAREGRID_DEPLOYMENT_HOSTNAME=
# Reviewed restore host-provider IDs only; keep empty until an implementation passes compatibility review.
COMPATIBILITY_RESTORE_ISOLATION_PROVIDER_IDS=
# Platform DB backups are disabled until an independent remote destination and
# isolated MySQL import-verification endpoint are configured and drilled.
PLATFORM_DB_BACKUP_ENABLED=false
PLATFORM_DB_BACKUP_DISK=platform_backups
PLATFORM_DB_BACKUP_DRIVER=local
PLATFORM_DB_BACKUP_LOCAL_ROOT=
PLATFORM_DB_BACKUP_PREFIX=platform-database
PLATFORM_DB_BACKUP_SOURCE_CONNECTION=
PLATFORM_DB_BACKUP_S3_KEY=
PLATFORM_DB_BACKUP_S3_SECRET=
PLATFORM_DB_BACKUP_S3_REGION=us-east-1
PLATFORM_DB_BACKUP_S3_BUCKET=
PLATFORM_DB_BACKUP_S3_ENDPOINT=
PLATFORM_DB_BACKUP_S3_PATH_STYLE=false
PLATFORM_DB_BACKUP_ENCRYPTION_CURRENT_KEY_ID=
PLATFORM_DB_BACKUP_ENCRYPTION_KEYRING={}
PLATFORM_DB_BACKUP_VERIFY_CONNECTION=
PLATFORM_DB_BACKUP_VERIFY_DATABASE_PREFIX=
PLATFORM_DB_BACKUP_VERIFY_ISOLATED=false
PLATFORM_DB_BACKUP_VERIFY_DB_HOST=127.0.0.1
PLATFORM_DB_BACKUP_VERIFY_DB_PORT=3306
PLATFORM_DB_BACKUP_VERIFY_DB_DATABASE=information_schema
PLATFORM_DB_BACKUP_VERIFY_DB_USERNAME=
PLATFORM_DB_BACKUP_VERIFY_DB_PASSWORD=
PLATFORM_DB_BACKUP_VERIFY_DB_SOCKET=
PLATFORM_DB_BACKUP_VERIFY_DB_SSL_CA=
# Synthetic M8 fixture support is separately enabled on a verified staging host.
SYNTHETIC_FIXTURE_PROVISIONING_ENABLED=false
SYNTHETIC_FIXTURE_CONTROLLED_EXECUTION_ENABLED=false
M8_SYNTHETIC_SECURITY_SCAN_ENABLED=false
SYNTHETIC_FIXTURE_RESTORE_ENABLED=false
M8_SYNTHETIC_SITE_UUID=

# Language for visitors who have not chosen (hu or en); everyone can switch (docs/LOCALIZATION.md).
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Optional marketing analytics. Collection remains disabled unless both gates,
# a reviewed policy, a valid production GA4 Measurement ID, and visitor consent exist.
MARKETING_ANALYTICS_ENABLED=false
MARKETING_ANALYTICS_POLICY_AUTHORIZED=false
GA4_MEASUREMENT_ID=
MARKETING_ANALYTICS_CONSENT_VERSION=technical-v1

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ----- HTTP security (config/http.php) ---------------------------------------
# Redirect to HTTPS and generate https:// links. Defaults to on when APP_URL is https://.
# HTTP_FORCE_HTTPS=true
# Strict-Transport-Security on HTTPS responses (default: on in production).
# HTTP_HSTS=true
HTTP_HSTS_MAX_AGE=15552000
HTTP_HSTS_INCLUDE_SUBDOMAINS=false
# Content-Security-Policy: off | report-only | enforce. Try report-only on staging first.
HTTP_CSP=off
HTTP_CSP_REPORT_URI=
# Load balancer / reverse proxy addresses whose X-Forwarded-* headers are trusted (comma list or *).
TRUSTED_PROXIES=

# ----- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# info or warning in production.
LOG_LEVEL=debug

# ----- Database ------------------------------------------------------------------
# Production: mysql (8.4 is tested in CI). SQLite for development and tests.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# ----- Sessions and cache ------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure (HTTPS-only) session cookies. Defaults to on when APP_URL is https://.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----- Queues (docs/DEPLOYMENT.md: two workers) ---------------------------------
# database: run "queue:work database --queue=default" and "queue:work backups --queue=backups".
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
# Backup transfers have their own connection (config/queue.php "backups"); its
# retry_after is BACKUP_TRANSFER_TIMEOUT + 600 so a running transfer is never picked up twice.
BACKUP_QUEUE_CONNECTION=backups
BACKUP_QUEUE=backups
BACKUP_TRANSFER_TIMEOUT=3600

# ----- Mail ----------------------------------------------------------------------
# smtp (or another real mailer) in production; log only writes mail to the log file.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Laravel's default S3 disk. Not used by WP CareGrid (backups use BACKUP_S3_* below).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----- Marketing site links (defaults: /login, /contact) -------------------------
# Set only to send these links elsewhere; empty means the default.
# MARKETING_LOGIN_URL=
# MARKETING_CONTACT_URL=

# ----- Stripe (docs/DEPLOYMENT.md "Stripe") --------------------------------------
# TEST MODE keys only (sk_test_… / pk_test_…). Never commit real values.
# A live key is refused unless STRIPE_ALLOW_LIVE_MODE=true.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_PORTAL_CONFIGURATION=
STRIPE_ALLOW_LIVE_MODE=false
STRIPE_MODE=test

# Pricing (see config/pricing.php). Checkout refuses any price without a Stripe Price ID.
PRICING_DISPLAY_MARKET=hu
PRICING_HU_TAX_TREATMENT=final_price_no_vat_added
# Stripe Products the Prices below must belong to (checked by pricing:verify-stripe).
STRIPE_PRODUCT_WORDPRESS=
STRIPE_PRODUCT_WOOCOMMERCE=
STRIPE_PRICE_WORDPRESS_BASIC_MONTHLY_HUF=
STRIPE_PRICE_WORDPRESS_BASIC_ANNUAL_HUF=
STRIPE_PRICE_WORDPRESS_BUSINESS_MONTHLY_HUF=
STRIPE_PRICE_WORDPRESS_BUSINESS_ANNUAL_HUF=
STRIPE_PRICE_WORDPRESS_SECURE_MONTHLY_HUF=
STRIPE_PRICE_WORDPRESS_SECURE_ANNUAL_HUF=
STRIPE_PRICE_WOOCOMMERCE_BASIC_MONTHLY_HUF=
STRIPE_PRICE_WOOCOMMERCE_BASIC_ANNUAL_HUF=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_MONTHLY_HUF=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_ANNUAL_HUF=
STRIPE_PRICE_WOOCOMMERCE_SECURE_MONTHLY_HUF=
STRIPE_PRICE_WOOCOMMERCE_SECURE_ANNUAL_HUF=

# Fixed international Stripe TEST catalog prices (currency-specific, no FX conversion).
STRIPE_PRICE_WORDPRESS_BASIC_MONTHLY_EUR=
STRIPE_PRICE_WORDPRESS_BASIC_ANNUAL_EUR=
STRIPE_PRICE_WORDPRESS_BUSINESS_MONTHLY_EUR=
STRIPE_PRICE_WORDPRESS_BUSINESS_ANNUAL_EUR=
STRIPE_PRICE_WORDPRESS_SECURE_MONTHLY_EUR=
STRIPE_PRICE_WORDPRESS_SECURE_ANNUAL_EUR=
STRIPE_PRICE_WOOCOMMERCE_BASIC_MONTHLY_EUR=
STRIPE_PRICE_WOOCOMMERCE_BASIC_ANNUAL_EUR=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_MONTHLY_EUR=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_ANNUAL_EUR=
STRIPE_PRICE_WOOCOMMERCE_SECURE_MONTHLY_EUR=
STRIPE_PRICE_WOOCOMMERCE_SECURE_ANNUAL_EUR=
STRIPE_PRICE_WORDPRESS_BASIC_MONTHLY_USD=
STRIPE_PRICE_WORDPRESS_BASIC_ANNUAL_USD=
STRIPE_PRICE_WORDPRESS_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_WORDPRESS_BUSINESS_ANNUAL_USD=
STRIPE_PRICE_WORDPRESS_SECURE_MONTHLY_USD=
STRIPE_PRICE_WORDPRESS_SECURE_ANNUAL_USD=
STRIPE_PRICE_WOOCOMMERCE_BASIC_MONTHLY_USD=
STRIPE_PRICE_WOOCOMMERCE_BASIC_ANNUAL_USD=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_ANNUAL_USD=
STRIPE_PRICE_WOOCOMMERCE_SECURE_MONTHLY_USD=
STRIPE_PRICE_WOOCOMMERCE_SECURE_ANNUAL_USD=
STRIPE_PRICE_WORDPRESS_BASIC_MONTHLY_GBP=
STRIPE_PRICE_WORDPRESS_BASIC_ANNUAL_GBP=
STRIPE_PRICE_WORDPRESS_BUSINESS_MONTHLY_GBP=
STRIPE_PRICE_WORDPRESS_BUSINESS_ANNUAL_GBP=
STRIPE_PRICE_WORDPRESS_SECURE_MONTHLY_GBP=
STRIPE_PRICE_WORDPRESS_SECURE_ANNUAL_GBP=
STRIPE_PRICE_WOOCOMMERCE_BASIC_MONTHLY_GBP=
STRIPE_PRICE_WOOCOMMERCE_BASIC_ANNUAL_GBP=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_MONTHLY_GBP=
STRIPE_PRICE_WOOCOMMERCE_BUSINESS_ANNUAL_GBP=
STRIPE_PRICE_WOOCOMMERCE_SECURE_MONTHLY_GBP=
STRIPE_PRICE_WOOCOMMERCE_SECURE_ANNUAL_GBP=

# ----- WP CareGrid Connector (docs/CONNECTOR.md) ---------------------------------
# Refuse plain-HTTP connector API calls (defaults to true in production).
# CONNECTOR_REQUIRE_HTTPS=true
CONNECTOR_HEARTBEAT_INTERVAL=900
CONNECTOR_POLL_INTERVAL=300
CONNECTOR_STALE_AFTER=2700
CONNECTOR_DISCONNECTED_AFTER=86400
CONNECTOR_PAIRING_CODE_TTL=1800
CONNECTOR_ALLOW_MAJOR_CORE_UPDATES=false

# ----- Backup storage (docs/BACKUP_ENGINE.md) ------------------------------------
# s3 or sftp in production. Empty = backups unavailable. local = development only.
BACKUP_STORAGE=
# S3-compatible storage (AWS, Wasabi, Backblaze B2, MinIO, Cloudflare R2…).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_PREFIX=backups
BACKUP_S3_PATH_STYLE=false
# legacy preserves BACKUP_S3_SSE behavior; explicit modes: sse-s3, sse-c, none.
# In sse-c mode BACKUP_S3_SSE is ignored; BACKUP_S3_SSE=AES256 does not select SSE-C.
BACKUP_S3_ENCRYPTION_MODE=legacy
BACKUP_S3_SSE=AES256
# SSE-C only: exactly 64 hexadecimal characters representing 32 random bytes. Keep secret and escrow securely.
# BACKUP_S3_SSE_C_KEY=
# Production only: explicit opt-in to mode=none when provider-side at-rest encryption is confirmed.
BACKUP_S3_ALLOW_UNENCRYPTED=false

# Cloudflare scoped API token: stored preferably through Owner Integrations.
# If configured in the environment, restrict it to Zone Read + DNS Read/Edit
# for only the exact zones listed below. DNS changes are never automatic.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ALLOWED_ZONES=wpcaregrid.com
CLOUDFLARE_PROTECTED_RECORD_NAMES=wpcaregrid.com,www.wpcaregrid.com,staging.wpcaregrid.com,stg1.wpcaregrid.com,wp-test.staging.wpcaregrid.com,mail.wpcaregrid.com
# SFTP storage.
BACKUP_SFTP_HOST=
BACKUP_SFTP_PORT=22
BACKUP_SFTP_USERNAME=
BACKUP_SFTP_PASSWORD=
# Prefer a key file on this server over a password.
BACKUP_SFTP_PRIVATE_KEY=
BACKUP_SFTP_PASSPHRASE=
# Required: "SHA256:..." as printed by ssh-keygen -lf for the server's host key.
BACKUP_SFTP_HOST_FINGERPRINT=
BACKUP_SFTP_ROOT=/backups
# Development only (BACKUP_STORAGE=local).
# BACKUP_LOCAL_ROOT=

# ----- Backup engine ---------------------------------------------------------------
BACKUP_CHUNK_SIZE=4194304
# Uploads wait here (on this server) until stored and verified. Size the disk for the
# largest site times the number of parallel uploads; system:check warns below the minimum.
# BACKUP_STAGING_PATH=
BACKUP_STAGING_MIN_FREE_MB=20480
# BACKUP_MAX_OBJECT_SIZE=
BACKUP_TRANSFER_TRIES=3
BACKUP_VERIFY_READBACK=true
BACKUP_PRE_UPDATE_REQUIRED=true
BACKUP_MANUAL_COOLDOWN_MINUTES=60
# Live restore. Keep false until the staging rehearsal in docs/RELEASE_CHECKLIST.md is done.
BACKUP_RESTORE_ENABLED=false
# Retention per plan: no defaults (nothing is deleted until set). Examples:
# BACKUP_RETENTION_WORDPRESS_BASIC_COUNT=
# BACKUP_RETENTION_WORDPRESS_SECURE_DAYS=

# ----- Secure WordPress admin access (docs/ADMIN_ACCESS.md) -----------------------
ADMIN_ACCESS_TOKEN_TTL=120
ADMIN_ACCESS_MAINTENANCE_MINUTES=30
ADMIN_ACCESS_FULL_ADMIN_MINUTES=15
ADMIN_ACCESS_MAX_REQUESTS_PER_HOUR=10
ADMIN_ACCESS_FULL_ADMIN_ALLOWED=true
# Operators with admin_access.full may request full admin only when true (docs/OPERATOR_CONSOLE.md).
ADMIN_ACCESS_OPERATOR_FULL_ADMIN=false

# ----- Security & Malware Engine (docs/SECURITY_ENGINE.md) ------------------------
SECURITY_SCAN_TIME_BUDGET=60
SECURITY_SCAN_MAX_PARTS=20
SECURITY_SCAN_TIMEOUT_MINUTES=120
SECURITY_SCAN_FRESH_FOR_DAYS=35
# none | wordfence. Without a source, vulnerabilities are reported as "not configured".
SECURITY_VULNERABILITY_SOURCE=none
SECURITY_VULNERABILITY_FEED_URL=
SECURITY_VULNERABILITY_FEED_KEY=
SECURITY_VULNERABILITY_MAX_AGE_HOURS=72
SECURITY_VULNERABILITY_SCHEDULE_ENABLED=false
SECURITY_SCHEDULE_ENABLED=false
SECURITY_INCIDENT_AUTO_OPEN=true
SECURITY_INCIDENT_AUTO_BACKUP=true
# Changes files on customer sites. Keep false in production (docs/SECURITY_INCIDENTS.md).
SECURITY_REMEDIATION_ENABLED=false
SECURITY_REMEDIATION_BACKUP_MAX_AGE=60
SECURITY_REMEDIATION_ALLOW_DISABLE_PLUGIN=false

# ----- Owner area (docs/OWNER_ADMIN.md) ---------------------------------------------
# How long a signed draft preview link stays valid (minutes).
CONTENT_PREVIEW_MINUTES=15

# ----- Invoice preparation (docs/SZAMLAZZ_HU_INTEGRATION.md) -------------------------
# Phase 1 creates local invoice intents and performs local-only validation.
INVOICE_PROVIDER=szamlazz_hu
SZAMLAZZ_PROVIDER_ENABLED=false
SZAMLAZZ_DRY_RUN=true
SZAMLAZZ_ISSUANCE_ENABLED=false
SZAMLAZZ_REQUEST_TIMEOUT=10
SZAMLAZZ_RETRY_LIMIT=3
SZAMLAZZ_CREDENTIAL_REFERENCE=szamlazz_agent
SZAMLAZZ_DEFAULT_LANGUAGE=hu
SZAMLAZZ_ACCOUNT_REFERENCE=
SZAMLAZZ_INVOICE_PREFIX_REFERENCE=
